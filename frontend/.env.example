# Public build-time configuration only. Never put tokens or secrets in VITE_*.
# Empty uses the same-origin local Vite proxy.
VITE_API_BASE_URL=
# Local dev/preview proxy target; never bundled into browser code.
API_PROXY_TARGET=http://127.0.0.1:8082
# Keep enabled locally; set false when the cloud listener keeps Actuator private.
VITE_READINESS_ENABLED=true
